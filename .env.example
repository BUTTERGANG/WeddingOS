# ─────────────────────────────────────────────────────────────────
# WeddingOS — Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy to .env before running:
#   cp .env.example .env
#
# Replit: Set these in the Secrets tab (Tools > Secrets)
# ─────────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ──────────────────────────────────────────
# Use a Neon, Supabase, or any Postgres connection string
APP_DATABASE_URL=postgresql://user:***@host:5432/dbname
# For local dev only (falls back to APP_DATABASE_URL if unset)
# APP_DATABASE_DEVELOPMENT=postgresql://user:***@host:5432/dbname_dev

# ── Port (optional, defaults to 5000) ───────────────────────────
# PORT=5000

# ── Replit (auto-set by Replit, don't change) ───────────────────
# REPLIT_ID=
# REPLIT_DEV_DOMAIN=

# ── Optional: AI Pricing (OpenRouter) ───────────────────────────
# OPENROUTER_API_KEY=

# ── Optional: Email (AgentMail + SMTP fallback) ────────────────
# AGENTMAIL_API_KEY=
# RESEND_API_KEY=

# ── Optional: Payments (Stripe) ─────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Optional: File Uploads (S3-compatible) ──────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET=

# ── Optional: Error Tracking ────────────────────────────────────
# SENTRY_DSN=