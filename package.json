{
  "name": "weddingos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @weddingos/api run dev\" \"pnpm --filter @weddingos/app run dev\"",
    "build": "pnpm -r build",
    "start": "pnpm --filter @weddingos/api run start",
    "check": "pnpm -r check",
    "db:push": "pnpm --filter @weddingos/db run push",
    "db:generate": "pnpm --filter @weddingos/db run generate",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0"
  }
}
